# ===========================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ===========================================

# Basic Information
ENVIRONMENT=production
DEBUG=false
APP_NAME=Network Tracker

# Database Configuration (Production)
MONGODB_URI_PROD=mongodb+srv://username:password@your-cluster.mongodb.net
MONGODB_DB_PROD=network_tracker_prod
MONGODB_CERT_FILE=/path/to/your/certificate.pem

# JWT and Hashing (CRITICAL: Use strong, unique keys!)
ACCESS_SECRET_KEY=your_production_access_secret_key_here_make_it_very_long_and_random_at_least_64_characters
REFRESH_SECRET_KEY=your_production_refresh_secret_key_here_make_it_very_long_and_random_at_least_64_characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=10080  # 7 days

HASHING=bcrypt

# Chatbot API (Production key)
CHATBOT_API_KEY=your_production_chatbot_api_key_here

# CORS Origins (Production - only your actual domains)
CORS_ORIGINS_PROD=["https://yourdomain.com", "https://www.yourdomain.com", "https://app.yourdomain.com"]

# Security Headers (Production - maximum security)
ENABLE_HSTS=true
ENABLE_CSP=true
ENABLE_X_FRAME_OPTIONS=true
ENABLE_X_CONTENT_TYPE_OPTIONS=true

# ===========================================
# PRODUCTION SECURITY NOTES:
# - DEBUG is disabled for security
# - HSTS is enabled for HTTPS enforcement
# - Use production MongoDB with SSL/TLS
# - CORS only allows your actual domains
# - Use strong, unique secret keys
# - Consider using environment variables for secrets
# ===========================================
