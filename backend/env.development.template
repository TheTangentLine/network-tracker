# ===========================================
# DEVELOPMENT ENVIRONMENT CONFIGURATION
# ===========================================

# Basic Information
ENVIRONMENT=development
DEBUG=true
APP_NAME=Network Tracker (Dev)

# Database Configuration (Development)
MONGODB_URI_DEV=mongodb://localhost:27017
MONGODB_DB_DEV=network_tracker_dev
MONGODB_CERT_FILE=

# JWT and Hashing (Use strong keys in production!)
ACCESS_SECRET_KEY=your_development_access_secret_key_here_make_it_long_and_random
REFRESH_SECRET_KEY=your_development_refresh_secret_key_here_make_it_long_and_random
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080  # 7 days

HASHING=bcrypt

# Chatbot API (Development key)
CHATBOT_API_KEY=your_development_chatbot_api_key_here

# CORS Origins (Development)
CORS_ORIGINS_DEV=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:3000", "http://127.0.0.1:5173"]

# Security Headers (Development - can be more permissive)
ENABLE_HSTS=false
ENABLE_CSP=true
ENABLE_X_FRAME_OPTIONS=true
ENABLE_X_CONTENT_TYPE_OPTIONS=true

# ===========================================
# DEVELOPMENT NOTES:
# - DEBUG is enabled for easier development
# - HSTS is disabled for local development
# - Use local MongoDB instance
# - CORS allows localhost origins
# ===========================================
